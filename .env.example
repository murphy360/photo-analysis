# API auth for clients calling this service (Home Assistant, memoire, MCP adapter, ...)
PHOTO_SERVICE_API_KEY=change-me

# --- Vision-LLM providers (enable any subset; orchestrator uses whichever have keys set) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_CHEAP=gemini-flash-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini

# xAI Grok uses an OpenAI-compatible Chat Completions API at a different base URL.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-vision-1212
GROK_MODEL_CHEAP=grok-2-vision-1212

# --- CompreFace (facial recognition, self-hosted) ---
COMPREFACE_URL=http://compreface-api:8000
COMPREFACE_RECOGNITION_API_KEY=
COMPREFACE_SIMILARITY_THRESHOLD=0.85

# --- Storage ---
DATABASE_URL=sqlite+aiosqlite:////app/data/photo_analysis.db
MEDIA_DIR=/app/data/media

# --- Triage / cost-control ---
# Path to the per-source policy file (see app/config/sources.example.yaml).
SOURCES_CONFIG_PATH=/app/app/config/sources.yaml
TRIAGE_CONFIDENCE=0.4

# --- MCP adapter (mcp_server/) ---
# Points at the core service above; same API key, just a different client.
PHOTO_API_URL=http://app:8000
PHOTO_API_KEY=change-me
